{
  "name": "seeker-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable shared integration platform for products on Solana Seeker.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "lint:secrets": "node scripts/check-no-secrets.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@solana-mobile/mobile-wallet-adapter-protocol": "^2.3.0",
    "@solana-mobile/mobile-wallet-adapter-protocol-kit": "^0.4.0",
    "@solana/kit": "^7.1.1",
    "@x402/core": "^2.23.0",
    "@x402/fetch": "^2.23.0",
    "@x402/svm": "^2.23.0"
  }
}
